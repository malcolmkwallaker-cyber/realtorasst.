# ── Core ──────────────────────────────────────────────────────────────────────
# Required for the Realtor Daily Assistant (Daily Planner, VA Handoff, How-To)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Access control ────────────────────────────────────────────────────────────
# Set a shared password so only your team can use the app.
# Leave blank to disable (anyone with the URL can access it).
APP_PASSWORD=choose_a_strong_team_password

# ── CRE Lead Gen module ───────────────────────────────────────────────────────
# Required only when the lead gen module is active (all three must be set)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# OpenAI — used for AI enrichment, CRE scoring, and outreach generation
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ── Export targets (optional) ─────────────────────────────────────────────────
# Google Sheets — path to service account JSON key file
GOOGLE_SERVICE_ACCOUNT_JSON=./google_service_account.json
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Airtable
AIRTABLE_API_KEY=your_airtable_api_key_here
AIRTABLE_BASE_ID=your_airtable_base_id_here
AIRTABLE_TABLE_NAME=CRE Leads

# ── Scraper tuning (optional) ─────────────────────────────────────────────────
# SerpAPI key enables a faster/lighter Google Maps fallback (no Playwright needed)
SERPAPI_KEY=

PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000
SCRAPE_DELAY_SECONDS=2.0
MAX_CONCURRENT_SCRAPERS=3
